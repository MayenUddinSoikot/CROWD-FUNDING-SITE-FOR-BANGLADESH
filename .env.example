# Copy this file to .env.local for local development.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# NEVER commit .env.local or paste real values into chat/code.

# Supabase (Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SSLCommerz (merchant panel → API credentials). Server-side only.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
# "true" while testing with the sandbox account, "false" for real payments
SSLCOMMERZ_SANDBOX=true
